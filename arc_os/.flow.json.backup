        "head": "",
        "format": "<style>\n    /* 1. This is the border you added earlier */\n    .bold-box {\n        border: 4px solid #b8f5b8ff !important; \n        border-radius: 8px !important;        \n    }\n\n    /* 2. NEW: This targets the title of the group */\n    .bold-box .v-card-title {\n        font-size: 28px !important;      /* Makes the font bigger */\n        font-weight: bold !important;    /* Makes the font thicker */\n        width: 100% !important;          /* Gives it the full width of the box */\n        display: flex !important;        /* Required for centering */\n        justify-content: center !important; /* Pushes the text to the exact center */\n    }\n</style>",
