    },
    {
        "id": "a00f2cda8a914983",
        "type": "function",
        "z": "37c42323e7f1140b",
        "name": "function 4",
        "func": "let d = new Date();\n\n// Convert number to 6-digit binary\nfunction getBin(num) {\n    return num.toString(2).padStart(6, '0');\n}\n\nlet h = getBin(d.getHours());\nlet m = getBin(d.getMinutes());\nlet s = getBin(d.getSeconds());\n\n// Function to draw a row of dots with the correct colors\nfunction drawRow(label, binaryStr) {\n    let rowHtml = `<div style=\"display: flex; align-items: center; margin-bottom: 10px;\">\n        <div style=\"color: #888; width: 40px; text-align: right; margin-right: 15px; font-weight: bold; font-size: 16px;\">${label}</div>`;\n    \n    // Check each of the 6 digits (0 or 1)\n    for (let i = 0; i < 6; i++) {\n        let isOn = binaryStr[i] === '1';\n        let bg = isOn ? '#00ffcc' : '#333'; // Neon green if ON, dark grey if OFF\n        let glow = isOn ? 'box-shadow: 0 0 12px #00ffcc;' : '';\n        rowHtml += `<div style=\"width: 24px; height: 24px; border-radius: 50%; background: ${bg}; margin: 0 6px; transition: all 0.2s; ${glow}\"></div>`;\n    }\n    rowHtml += `</div>`;\n    return rowHtml;\n}\n\n// Build the final HTML box\nmsg.payload = `<div style=\"background: #111; padding: 20px; border-radius: 12px; display: inline-block; font-family: monospace;\">\n    ${drawRow('HR', h)}\n    ${drawRow('MIN', m)}\n    ${drawRow('SEC', s)}\n</div>`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 180,
        "wires": [
            [
                "faf6f6ae0c9a2c8a",
                "8a34164adefe01b2"
            ]
        ]
    },
    {
        "id": "faf6f6ae0c9a2c8a",
        "type": "ui-template",
        "z": "37c42323e7f1140b",
        "d": true,
        "group": "11ffca905b3907f1",
        "page": "",
        "ui": "",
        "name": "",
        "order": 0,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<style>\n  /* The Matrix Container */\n  .matrix-container {\n      background: #111;\n      padding: 20px;\n      border-radius: 12px;\n      display: inline-block;\n      font-family: monospace;\n  }\n  /* The Rows */\n  .matrix-row {\n      display: flex;\n      align-items: center;\n      margin-bottom: 10px;\n  }\n  /* The Row Labels (HR, MIN, SEC) */\n  .matrix-label {\n      color: #888;\n      width: 40px;\n      text-align: right;\n      margin-right: 15px;\n      font-weight: bold;\n      font-size: 16px;\n  }\n  /* The Default (Off) Dots */\n  .dot {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      background: #333;\n      margin: 0 6px;\n      transition: background 0.2s, box-shadow 0.2s;\n  }\n  /* The Glowing (On) Dots */\n  .dot-on {\n      background: #00ffcc;\n      box-shadow: 0 0 12px #00ffcc;\n  }\n</style>\n\n<div class=\"matrix-container\">\n    \n  <div class=\"matrix-row\">\n     <div class=\"matrix-label\">HR</div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.h[0] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.h[1] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.h[2] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.h[3] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.h[4] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.h[5] === '1'}\"></div>\n  </div>\n\n  <div class=\"matrix-row\">\n     <div class=\"matrix-label\">MIN</div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.m[0] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.m[1] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.m[2] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.m[3] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.m[4] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.m[5] === '1'}\"></div>\n  </div>\n\n  <div class=\"matrix-row\">\n     <div class=\"matrix-label\">SEC</div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.s[0] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.s[1] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.s[2] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.s[3] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.s[4] === '1'}\"></div>\n     <div class=\"dot\" ng-class=\"{'dot-on': msg.payload.s[5] === '1'}\"></div>\n  </div>\n\n</div>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 560,
        "y": 180,
