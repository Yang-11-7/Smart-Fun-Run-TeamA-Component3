    {
        "id": "9b618fe05d11c3f4",
        "type": "function",
        "z": "37c42323e7f1140b",
        "name": "function 4",
        "func": "let latestRecord = \"\";\n\n// Loop through all the rows\nfor (let i = 0; i < msg.payload.length; i++) {\n    let person = msg.payload[i][\"The Person Finish Run\"];\n    let status = msg.payload[i][\"Status\"];\n    let time = msg.payload[i][\"Timestamp\"]; // Grab the exact time from Column A\n    \n    // Check if the cell has a name AND is checking in\n    if (person && person.trim() !== \"\" && status === \"Check in\") {\n        \n        // Format the text to match your desired style\n        latestRecord = \"🏃 \" + person + \" registered at \" + time;\n    }\n}\n\n// Output the final formatted string\nif (latestRecord !== \"\") {\n    msg.payload = latestRecord;\n} else {\n    msg.payload = \"Waiting for runners...\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 680,
        "wires": [
