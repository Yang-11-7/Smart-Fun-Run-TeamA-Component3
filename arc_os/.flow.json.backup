    {
        "id": "51a4d3f2e35e643d",
        "type": "function",
        "z": "37c42323e7f1140b",
        "name": "function 2",
        "func": "// 1. Get the list from memory. \n// IF it doesn't exist yet, create 5 blank placeholder slots!\nlet runnerList = flow.get(\"runnerList\");\nif (!runnerList) {\n    runnerList = [\"- Waiting for runner -\", \"- Waiting for runner -\", \"- Waiting for runner -\", \"- Waiting for runner -\", \"- Waiting for runner -\"];\n}\n\n// 2. Format the new entry\nlet runnerName = msg.payload; \nlet currentTime = new Date().toLocaleTimeString(); \nlet newEntry = \"🏃 \" + runnerName + \" registered at \" + currentTime;\n\n// 3. Add the new entry to the very TOP of the list (Index 0)\nrunnerList.unshift(newEntry);\n\n// 4. Chop off anything past 5 items (the oldest one at the bottom falls off)\nrunnerList.length = 5; \n\n// 5. Save the updated list back to memory\nflow.set(\"runnerList\", runnerList);\n\n// 6. Join the items together with line breaks\n// Define the fading opacities for the 5 slots (1.0 is dark, 0.2 is very light)\nlet opacities = [1.0, 0.8, 0.6, 0.4, 0.2];\n\n// Wrap each line in an HTML span tag with the matching opacity\nlet styledList = runnerList.map((item, index) => {\n    return `<span style=\"opacity: ${opacities[index]};\">${item}</span>`;\n});\n\n// Join them together with line breaks just like before\nmsg.payload = styledList.join(\"<br><br>\");\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 340,
        "wires": [
            [
                "737f7057ac5cfa18",
                "b4598cd0367c5e8b"
            ]
        ]
    },
