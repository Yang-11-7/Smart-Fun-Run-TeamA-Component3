    {
        "id": "b4d1c51264afea20",
        "type": "function",
        "z": "37c42323e7f1140b",
        "name": "function 3",
        "func": "// 1. Get the leaderboard from memory. If it's empty, start a blank list.\nlet leaderboard = flow.get(\"leaderboard\") || [];\n\n// 2. STOP LOGIC: If we already have 3 winners, ignore any new names!\nif (leaderboard.length >= 3) {\n    return null; // This kills the message so it doesn't update the screen\n}\n\n// 3. Grab the name and the exact finish time\nlet runnerName = msg.payload;\nlet finishTime = new Date().toLocaleTimeString();\n\n// 4. Add the new finisher to our list\nleaderboard.push(runnerName + \" (Finished at \" + finishTime + \")\");\n\n// 5. Save the updated list back to memory\nflow.set(\"leaderboard\", leaderboard);\n\n// 6. Format the display with Medals!\nlet displayLines = [];\nlet medals = [\"🥇 1st Place:\", \"🥈 2nd Place:\", \"🥉 3rd Place:\"];\n\n// Loop through the 3 podium spots\nfor (let i = 0; i < 3; i++) {\n    if (leaderboard[i]) {\n        // If someone is in this spot, show their name and time\n        displayLines.push(`<b>${medals[i]}</b> ${leaderboard[i]}`);\n    } else {\n        // If the spot is empty, show that they are still racing\n        displayLines.push(`<b>${medals[i]}</b> <i>- Still Racing -</i>`);\n    }\n}\n\n// 7. Join them together with line breaks\nmsg.payload = displayLines.join(\"<br><br>\");\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 500,
        "wires": [
            [
                "df4759a03c36e3d6"
            ]
        ]
    },
